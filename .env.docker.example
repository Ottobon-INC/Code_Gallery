# Docker Env Template
# Copy this to .env.docker before running docker compose

# ==========================================
# Database Connection (Crucial: Must be set to your Supabase URL)
# ==========================================
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ==========================================
# API Configuration 
# ==========================================
PORT=3000

# ==========================================
# Web Frontend Configuration
# ==========================================
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=changeme123securesecret
NEXT_PUBLIC_API_URL=http://localhost:3000

# ==========================================
# Email SMTP Settings (For Password Reset)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Ottobon" <noreply@ottobon.in>
FRONTEND_URL=http://localhost:3001
